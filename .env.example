# ============================================================
# AI Stock Forecasting Platform - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to Git.

# --- Database ---
DATABASE_URL=postgresql://stockuser:stockpassword@localhost:5432/stockdb
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=stockpassword
POSTGRES_DB=stockdb

# --- Market Data Provider ---
# Supported providers: "yfinance" (free, no key needed), "alpha_vantage", "polygon"
MARKET_DATA_PROVIDER=yfinance

# Alpha Vantage (https://www.alphavantage.co/support/#api-key)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Polygon.io (https://polygon.io/)
POLYGON_API_KEY=your_polygon_key_here

# --- News / Sentiment ---
# Supported providers: "newsapi", "sample"
# "sample" uses explicitly-labeled demo data when no key is provided
NEWS_API_KEY=your_newsapi_key_here
NEWS_PROVIDER=sample

# --- Application ---
SECRET_KEY=change-this-to-a-long-random-secret-key
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- ML Pipeline ---
# Directory where trained model artifacts are saved
MODEL_ARTIFACTS_DIR=./models
DATA_DIR=./data

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
